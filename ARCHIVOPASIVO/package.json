{
  "name": "archivopasivodev",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema administrativo monolitico para Archivo Pasivo con API Node, React, JWT, RBAC, auditoria y 2FA opcional.",
  "type": "module",
  "main": "dist/src/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed-admin": "node scripts/seed-admin.js",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart archivopasivodev"
  },
  "dependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
