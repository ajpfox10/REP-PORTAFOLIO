# ══════════════════════════════════════════════════════════════════
#  VetManager Pro — Variables de entorno (desarrollo y producción)
#  Copiar a .env y completar todos los valores marcados con CHANGE_ME
#  NUNCA commitear .env con valores reales
# ══════════════════════════════════════════════════════════════════

# ─── Base de datos (AWS RDS) ──────────────────────────────────────
MYSQL_HOST=CHANGE_ME.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=veterinaria
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_POOL_MIN=2
MYSQL_POOL_MAX=20
SLOW_QUERY_MS=500

# ─── Redis ────────────────────────────────────────────────────────
# Railway interno:
REDIS_URL=redis://:CHANGE_ME@redis.railway.internal:6379?family=0
# Docker local (si corrés docker-compose.yml):
# REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME
DEPENDENCY_MODE_AUTH_REVOCATION=strict
DEPENDENCY_MODE_AUTH_SESSION_SECURITY=strict
AUTH_REVOCATION_SYNC_INTERVAL_MS=60000

# ─── JWT (RS256 asimétrico) ───────────────────────────────────────
# Generar: openssl genrsa -out private.pem 2048
#          openssl rsa -in private.pem -pubout -out public.pem
#          base64 -w 0 private.pem   # pegar en JWT_PRIVATE_KEY
#          base64 -w 0 public.pem    # pegar en JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=CHANGE_ME_base64_encoded_pem
JWT_PUBLIC_KEY=CHANGE_ME_base64_encoded_pem
# Opcional para rotacion coordinada entre servicios. Generar con: npm run secrets:jwt-rotate
# JWT_KEYRING_JSON=CHANGE_ME_base64_encoded_json
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REVOCATION_TTL_SEC=900

# ─── Secreto interno (service-to-service HMAC) ───────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
INTERNAL_SECRET=CHANGE_ME_min_64_chars_hex
INTERNAL_SIG_TTL_S=60

# ─── App / API ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_VERSION=v1
APP_VERSION=1.0.0
APP_DOMAIN=vetmanager.io

# ─── CORS y hosts permitidos ─────────────────────────────────────
ALLOWED_HOSTS=CHANGE_ME.up.railway.app
ALLOWED_ORIGINS=https://CHANGE_ME.up.railway.app
CORS_ORIGINS=https://CHANGE_ME.up.railway.app
CSRF_SECRET=CHANGE_ME_min_64_chars_hex
FIELD_ENCRYPTION_SECRET=CHANGE_ME_min_32_chars_random_string_here
FIELD_ENCRYPTION_SALT=CHANGE_ME_unique_random_salt
CSRF_EXCLUDE_PATHS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/auth/password-reset/request,/api/v1/auth/password-reset/confirm,/api/v1/auth/2fa/challenge,/api/v2/auth/2fa/challenge,/api/v1/payments/mp/webhook

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ─── Circuit Breaker ─────────────────────────────────────────────
CIRCUIT_THRESHOLD=5
CIRCUIT_TIMEOUT_MS=30000
CIRCUIT_SUCCESS=2

# ─── WebSockets ──────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30000

# ─── Logs y trazabilidad ─────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
TRACING_ENABLED=true
TRACING_EXPORTER_URL=http://tempo:9411/api/v2/spans
METRICS_TOKEN=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME
SERVICE_DISCOVERY_MODE=hybrid
EVENT_BUS_OUTBOX=true
EVENT_BUS_OUTBOX_RELAY_INTERVAL_MS=5000
EVENT_BUS_OUTBOX_MAX_ATTEMPTS=10

# ─── Seguridad / Feature flags ───────────────────────────────────
CAPTCHA_ENABLED=false
HCAPTCHA_SECRET=CHANGE_ME
HCAPTCHA_SITE_KEY=CHANGE_ME
VITE_CAPTCHA_ENABLED=false
VITE_HCAPTCHA_SITE_KEY=CHANGE_ME
DEVICE_FINGERPRINT_ENABLED=true
DLP_EXPORT_THRESHOLD=1000
DLP_EXPORT_WINDOW_SECS=300

# ─── Storage S3 / MinIO ──────────────────────────────────────────
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=vetmanager-prod
MINIO_BUCKET_PATIENTS=patient-files
MINIO_BUCKET_GROOMING=grooming-photos
MINIO_BUCKET_TELE=tele-docs
MINIO_BUCKET_DOCUMENTS=documents-inbox
MAX_FILE_SIZE_MB=20

# ─── Email (SMTP / SendGrid) ─────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME
FROM_EMAIL=noreply@vetmanager.io

# ─── Stripe (billing) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_BASIC=price_CHANGE_ME
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME
BILLING_PORTAL_RETURN_URL=https://app.vetmanager.io/billing

# ─── MercadoPago ─────────────────────────────────────────────────
MP_ACCESS_TOKEN=CHANGE_ME
MP_PUBLIC_KEY=CHANGE_ME

# ─── Documents / Email providers ─────────────────────────────────
# Las credenciales efectivas se guardan por cuenta en mail_accounts.settings_json.
# Estas variables son solo referencia de bootstrap.
GOOGLE_REDIRECT_URI=https://api.vetmanager.io/documents/oauth/google/callback
DOCUMENTS_GMAIL_CLIENT_ID=CHANGE_ME
DOCUMENTS_GMAIL_CLIENT_SECRET=CHANGE_ME
DOCUMENTS_GMAIL_REFRESH_TOKEN=CHANGE_ME
DOCUMENTS_IMAP_HOST=imap.example.com
DOCUMENTS_IMAP_PORT=993
DOCUMENTS_IMAP_SECURE=true
DOCUMENTS_IMAP_USERNAME=documents@example.com
DOCUMENTS_IMAP_PASSWORD=CHANGE_ME
DOCUMENTS_OUTLOOK_TENANT_ID=CHANGE_ME
DOCUMENTS_OUTLOOK_CLIENT_ID=CHANGE_ME
DOCUMENTS_OUTLOOK_CLIENT_SECRET=CHANGE_ME

# ─── URLs internas (docker-compose local únicamente) ─────────────
# En Railway estos valores se configuran por servicio en el dashboard.
# En docker-compose.yml los SERVICE_* se inyectan directamente en el gateway.
SERVICE_AUTH=http://auth:4051
SERVICE_PATIENTS=http://patients:4052
SERVICE_MEDICAL=http://medical:4053
SERVICE_LAB=http://lab-imaging:4054
SERVICE_BILLING=http://billing:4055
SERVICE_TELEMEDICINE=http://telemedicine:4056
SERVICE_GROOMING=http://grooming:4057
SERVICE_REPORTS=http://reports:4058
SERVICE_NOTIFICATIONS=http://notifications:4059
SERVICE_PORTAL=http://portal:4060
SERVICE_AI=http://ai:4061
SERVICE_DOCUMENTS=http://documents:4062
