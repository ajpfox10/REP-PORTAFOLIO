# OT-090: Dependency confusion prevention
# All packages default to the public registry.
# Private/scoped packages use the org scope below.
# If you have a private registry, set NPM_TOKEN and uncomment the scoped registry lines.

registry=https://registry.npmjs.org/

# Prevent install of packages with internal names from the public registry.
# For private scopes (e.g. @vetmanager), configure a private registry:
# @vetmanager:registry=https://npm.your-private-registry.com/
# //npm.your-private-registry.com/:_authToken=${NPM_TOKEN}

# Lock the engine to the version used in Docker (node:20.18.3-alpine3.21)
engine-strict=false

# Fail on peer dependency conflicts (default in npm 7+)
legacy-peer-deps=false

# Do not allow running scripts from installed packages during install
# (set to true to harden; requires manual audit of postinstall scripts first)
# ignore-scripts=true

# Save exact versions by default to prevent unexpected upgrades
save-exact=false
