FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_URL
ARG VITE_PORTAL_ORG_ID
ARG VITE_CAPTCHA_ENABLED
ARG VITE_HCAPTCHA_SITE_KEY
ARG CAPTCHA_ENABLED
ARG HCAPTCHA_SITE_KEY
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_PORTAL_ORG_ID=${VITE_PORTAL_ORG_ID}
ENV VITE_CAPTCHA_ENABLED=${VITE_CAPTCHA_ENABLED}
ENV VITE_HCAPTCHA_SITE_KEY=${VITE_HCAPTCHA_SITE_KEY}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN VITE_CAPTCHA_ENABLED="${VITE_CAPTCHA_ENABLED:-$CAPTCHA_ENABLED}" \
    VITE_HCAPTCHA_SITE_KEY="${VITE_HCAPTCHA_SITE_KEY:-$HCAPTCHA_SITE_KEY}" \
    npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
