  "panels": [
    {
      "type": "timeseries",
      "title": "Request Volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (service) (rate(http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Dependency Errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (dependency, service) (rate(dependency_degradations_total{outcome=~\"blocked|failure|degraded\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Event Bus Failures / DLQ",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum by (topic, result) (rate(event_bus_messages_total{direction=\"consume\",result=~\"failure|dlq\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "traces",
