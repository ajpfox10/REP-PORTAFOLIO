<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HealthCoverageVerifier</RootNamespace>
    <AssemblyName>HealthCoverageVerifier</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web API / Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />

    <!-- Base de datos -->
    <PackageReference Include="MySqlConnector" Version="2.3.7" />

    <!-- Password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Browser automation -->
    <PackageReference Include="Microsoft.Playwright" Version="1.45.0" />

    <!-- OCR -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Asegurar que tessdata se copie al output -->
    <None Update="tessdata\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
