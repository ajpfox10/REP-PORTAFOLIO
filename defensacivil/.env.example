# Copiar como .env.dev (desarrollo) o .env.prod (Docker de producción)

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=defensacivil
DB_USER=defensacivil
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-clave-root   # solo para el contenedor de MySQL

# Sesión: dos secretos distintos de al menos 32 caracteres
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookie de sesión: 'strict' si frontend y API comparten dominio (nginx);
# 'none' si se publican en dominios distintos (requiere HTTPS)
COOKIE_SAMESITE=strict

# Solo si el frontend se sirve desde otro dominio (separar varios con coma)
CORS_ORIGIN=http://localhost:4070

BACKEND_PORT=4071
LOG_LEVEL=info
# LOG_DIR=/var/log/defensacivil   # además de la consola, guardar en archivos
# AUTO_IMPORT_DATA=false          # no descargar localidades e infraestructura al arrancar
