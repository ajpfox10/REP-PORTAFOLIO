{
  "name": "defensacivil-backend",
  "version": "1.0.0",
  "description": "Sistema de Reporte de Incidentes - Defensa Civil Argentina",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "import:data": "node scripts/import-data.js",
    "import:geo": "node scripts/import-data.js --solo-geo",
    "import:infra": "node scripts/import-data.js --solo-infra",
    "import:bsas": "node scripts/import-data.js --provincia AR-B",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "setupFiles": [
      "./tests/setupEnv.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
