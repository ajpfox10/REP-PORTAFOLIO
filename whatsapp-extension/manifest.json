{
  "manifest_version": 3,
  "name": "Personal - Asistente (WhatsApp y CUIL ANSES)",
  "version": "1.9.3",
  "description": "Desde la app de Personal: avisos por WhatsApp Web, constancia de CUIL de ANSES y certificado RDAM.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://servicioswww.anses.gob.ar/*",
    "https://rdam.mjus.gba.gob.ar/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.0.21/*",
        "http://10.115.31.28/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://servicioswww.anses.gob.ar/C2-ConstaCUIL*"
      ],
      "js": [
        "anses.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rdam.mjus.gba.gob.ar/*"
      ],
      "js": [
        "rdam.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
